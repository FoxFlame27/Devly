# --- Platform secrets (never exposed to the browser or to project sandboxes) ---
ANTHROPIC_API_KEY=
DATABASE_URL=postgresql://buildbot:buildbot@127.0.0.1:5433/buildbot
SESSION_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=change-me-to-a-64-hex-char-string
APP_URL=http://localhost:3000

# --- AI ---
# Comma-separated list of "id:Label:Description" entries. First entry is the default.
AI_MODELS="gpt-6-astra:GPT-6 Astra:Smartest. Best for whole builds and tricky fixes.,gpt-5.4:GPT-5.4:Very capable all-rounder.,gpt-5.3-codex:GPT-5.3 Codex:Tuned for coding tasks.,gpt-5.4-mini:GPT-5.4 Mini:Faster and lighter. Good for small changes.,gpt-5.4-nano:GPT-5.4 Nano:Fastest and cheapest. Tiny edits only.,gpt-5.2:GPT-5.2:Previous generation.,gemini-2.5-flash:Gemini 2.5 Flash:Free tier option (needs a Gemini key).,claude-opus-5:Claude Opus 5:Needs Anthropic API credit."
AI_EFFORT=high
# Optional: Google Gemini (free tier at https://aistudio.google.com/apikey). Gemini models are used for ids starting with "gemini".
GEMINI_API_KEY=
AI_DEFAULT_MODEL=gpt-6-astra

# --- Sandbox: auto | local | docker ---
SANDBOX_PROVIDER=auto

# --- Seed admin (created by `npm run db:seed` if it does not exist) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
# Seed access code that unlocks unlimited prompts
SEED_ACCESS_CODE=270513
# OpenAI (Responses API). Model ids starting with "gpt" use this key.
OPENAI_API_KEY=
# Meshy AI (3D model generation). Only users with unlimited access can generate models.
MESHY_API_KEY=
